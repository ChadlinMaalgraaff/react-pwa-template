# API Configuration
VITE_API_BASE_URL=http://localhost:8000

# Cognito Hosted UI / Google federated sign-in
# Cognito domain WITHOUT the https:// prefix, e.g. your-app.auth.eu-west-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
# Must exactly match a callback URL configured on the Cognito app client
VITE_OAUTH_REDIRECT_URI=https://www.whatslekker.co.za/auth/callback
# The identity provider name as registered in the Cognito user pool (usually "Google")
VITE_GOOGLE_IDP_NAME=Google

# Environment
VITE_ENVIRONMENT=development
VITE_DEBUG=true

# PWA Configuration
VITE_PWA_ENABLED=true
